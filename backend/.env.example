APP_NAME=AccoNova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33069
DB_DATABASE=acconova
DB_USERNAME=acconova
DB_PASSWORD=local-development-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# AccoNova AI Gateway
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_CHAT_PATH=/v1/chat/completions
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_TOKENS_FIELD=max_tokens

# api_key | oauth_refresh
AI_AUTH_MODE=api_key
AI_API_KEY=

# Required only when AI_AUTH_MODE=oauth_refresh
AI_TOKEN_URL=
AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_REFRESH_TOKEN=
AI_SCOPE=
AI_REFRESH_SKEW_SECONDS=60

# Conversation memory keeps recent messages and compacts older history.
AI_RECENT_MESSAGES=20
AI_SUMMARIZE_AFTER_MESSAGES=40
AI_SUMMARY_MAX_OUTPUT_TOKENS=700
AI_SUMMARY_TRANSCRIPT_CHARS=60000

# Temporary links should always be regenerated from stored file paths/IDs.
AI_TEMPORARY_URL_MINUTES=10
