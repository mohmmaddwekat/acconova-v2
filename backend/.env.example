APP_NAME=AccoNova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33069
DB_DATABASE=acconova
DB_USERNAME=acconova
DB_PASSWORD=local-development-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AccoNova Billing
# Keep BILLING_ENABLED=false until credentials, prices, and webhook are ready.
BILLING_ENABLED=false
# When billing is enabled, require an active/trialing workspace subscription.
BILLING_ENFORCE_SUBSCRIPTION=true
BILLING_PROVIDER=stripe
BILLING_ALLOW_PROMOTION_CODES=true
BILLING_TRIAL_DAYS=0

# Optional overrides. Leave blank to return to /app/billing.
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=

# Hosted subscription prices created in your billing provider.
BILLING_PRICE_STARTER_MONTHLY=
BILLING_PRICE_STARTER_YEARLY=
BILLING_PRICE_BUSINESS_MONTHLY=
BILLING_PRICE_BUSINESS_YEARLY=
BILLING_PRICE_SCALE_MONTHLY=
BILLING_PRICE_SCALE_YEARLY=

# Provider credentials stay server-side and must never be prefixed with VITE_.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

VITE_APP_NAME="${APP_NAME}"


# AccoNova AI Gateway
# The frontend never receives provider API keys.
AI_ENABLED=false
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_PROVIDERS=anthropic,gemini
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=1200

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_PATH=/v1/chat/completions
OPENAI_MAX_TOKENS_FIELD=max_completion_tokens

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MESSAGES_PATH=/v1/messages
ANTHROPIC_VERSION=2023-06-01

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta

# Custom OpenAI-compatible provider.
# Use AI_DEFAULT_PROVIDER=custom to make this the primary provider.
AI_CUSTOM_PROVIDER_LABEL="Custom AI"
AI_BASE_URL=
AI_CHAT_PATH=/v1/chat/completions
AI_MODEL=
AI_MAX_TOKENS_FIELD=max_tokens

# api_key | oauth_refresh (custom provider only)
AI_AUTH_MODE=api_key
AI_API_KEY=

# Required only when AI_AUTH_MODE=oauth_refresh
AI_TOKEN_URL=
AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_REFRESH_TOKEN=
AI_SCOPE=
AI_REFRESH_SKEW_SECONDS=60

# Safe AccoNova business tools. The model never receives raw database access.
AI_TOOLS_ENABLED=true
AI_TOOL_MAX_CALLS=4
AI_TOOL_PLANNER_MAX_OUTPUT_TOKENS=450
AI_TOOL_MAX_RESULT_CHARS=30000

# Conversation memory keeps recent messages and compacts older history.
AI_RECENT_MESSAGES=20
AI_CONTEXT_CHAR_BUDGET=60000
AI_SUMMARIZE_AFTER_MESSAGES=40
AI_SUMMARY_MAX_OUTPUT_TOKENS=700
AI_SUMMARY_TRANSCRIPT_CHARS=60000

# Temporary links are regenerated from stored file paths/IDs.
AI_TEMPORARY_URL_MINUTES=10
