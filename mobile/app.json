{
  "expo": {
    "name": "AccoNova",
    "slug": "acconova-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "acconova",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.acconova.mobile"
    },
    "android": {
      "supportsRtl": true,
      "package": "net.acconova.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#068CF0",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "root": "./app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "46305870-052e-4d93-a6cb-ed4eeb71126b"
      }
    },
    "owner": "mhmaddws-team"
  }
}
