{
  "expo": {
    "name": "AccoNova",
    "slug": "acconova-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "acconova",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.acconova.mobile"
    },
    "android": {
      "package": "net.acconova.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#068CF0",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
